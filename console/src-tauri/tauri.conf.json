{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NonZeroScript",
  "version": "0.1.0-dev",
  "identifier": "dev.nonzeroscript.console",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "NonZeroScript 控制台",
        "width": 1180,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8790 http://localhost:8790; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
