# Build output: temporary exe/PyInstaller/Tauri output is not tracked.
dist/exe/
dist/_pyinstaller/
console/src-tauri/target/
console/src-tauri/gen/

# Controller runtime data: settings.json + timeline memory (local, private)
controller/data/

# Python
__pycache__/
*.py[cod]
.venv/

# Archives elsewhere in the tree (release zips in dist/ are tracked)
*.zip
!dist/*.zip

# Node (parser test tooling only)
node_modules/

# Godot / editor noise
.godot/
*.translation

# System files
.DS_Store
Thumbs.db
desktop.ini

# local build staging
out/
